{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trained-assist-runner-api-telegram-ux-v1-sandbox",
  "account_id": "d740a05e9442c1d0feacae2dfc673e93",
  "main": "src/cloudflare/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER_RUNS",
        "class_name": "RunnerRunCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RunnerRunCoordinator"
      ]
    }
  ],
  "vars": {
    "RUNNER_API_PUBLIC_URL": "https://trained-assist-runner-api-telegram-ux-v1-sandbox.skillset-apply.workers.dev",
    "RUNNER_ENGINE": "eu-vm-agent-run",
    "GHA_WORKER_URL": "https://opencode-gha-runner-gateway-sandbox.skillset-apply.workers.dev",
    "MOCK_TEST_ENABLED": "true",
    "SANDBOX_CLEANUP_PROFILES": "integration-telegram-ux-v1",
    "ALLOWED_REPOSITORIES": "trained-assist/ai-agent-runner",
    "ALLOWED_ENVIRONMENT_NAMES": "LLM_LADDER_TOKEN",
  }
}
