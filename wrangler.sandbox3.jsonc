{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trained-assist-runner-api-sandbox3",
  "main": "src/cloudflare/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "RUNNER_RUNS", "class_name": "RunnerRunCoordinator" },
      { "name": "RUNNER_GITHUB_CONNECTIONS", "class_name": "RunnerGithubConnection" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerRunCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["RunnerGithubConnection"] }],
  "vars": {
    "RUNNER_API_PUBLIC_URL": "https://trained-assist-runner-api-sandbox3.skillset-apply.workers.dev",
    "RUNNER_ENGINE": "eu-vm-agent-run",
    "ZEROCREDS_API_URL": "https://zerocreds.ru",
    "MOCK_TEST_ENABLED": "true",
    "ALLOWED_REPOSITORIES": "trained-assist/ai-agent-runner",
    "ALLOWED_ENVIRONMENT_NAMES": "LLM_LADDER_TOKEN",
    "SANDBOX_CLEANUP_PROFILES": "sandbox3-vm2-live-canary"
  }
}
