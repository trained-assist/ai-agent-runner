[Unit]
Description=Agent Runner Serverless Agent API (single VM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sandbox
Group=sandbox
WorkingDirectory=/opt/sb/ai-agent-runner
EnvironmentFile=/etc/agent-runner/agent-runner-api.env
ExecStart=@NODE@ /opt/sb/ai-agent-runner/dist/api/main.js
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
# Граница Agent clean room (#51) поднимается без root: каталоги среды создаются под
# служебным uid и затем отдаются слоту (иначе mkdir внутри каталога слота требует
# DAC_OVERRIDE), а переключение идентичности рана делает setpriv. Поэтому процессу
# нужны ровно четыре capability: сменить uid/gid и передать владение каталогами.
# В наборе НЕТ DAC_OVERRIDE, DAC_READ_SEARCH и SYS_ADMIN — Runner не должен ни читать
# чужие файлы, ни обходить права доступа. Шире этого набора граница не расширяется.
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/agent-runner
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-runner-api

[Install]
WantedBy=multi-user.target
