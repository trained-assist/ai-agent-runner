[Unit]
Description=Agent Runner Serverless Agent API (stateless orchestrator, no disk state)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sandbox
Group=sandbox
WorkingDirectory=/opt/sb/ai-agent-runner
EnvironmentFile=/etc/agent-runner/agent-runner-api.env
ExecStart=@NODE@ /opt/sb/ai-agent-runner/dist/api/main.js
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM

# Stateless API (epic #74): процесс не пишет на диск и не запускает агентов, поэтому
# capabilities, ReadWritePaths и каталог данных ему не нужны. Единственный читаемый файл —
# реестр ключей из EnvironmentFile, а всё состояние ранов живёт в памяти процесса.
#
# Защиту оставляем прежней: NoNewPrivileges и ProtectSystem=full запрещают процессу
# повышать права и писать в системные каталоги, а PrivateTmp изолирует его от /tmp хоста.
# Никаких CAP_SETUID/CAP_SETGID: переключать идентичность рана теперь нечего — агента
# запускает внешний воркер на своей машине.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-runner-api

[Install]
WantedBy=multi-user.target
