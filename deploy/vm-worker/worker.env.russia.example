# Copy to /etc/ai-agent-runner/worker.env and set file mode 0600.
VM_WORKER_ID=ru-vm-1
VM_WORKER_ENGINE=rf-vm-agent-run
VM_WORKER_PUBLIC_URL=https://russia-worker.example.com
VM_WORKER_BINDINGS_INVENTORY=/etc/ai-agent-runner/worker-bindings.json
VM_WORKER_BIND=127.0.0.1
VM_WORKER_PORT=8788
VM_WORKER_DATA_DIR=/var/lib/ai-agent-runner
VM_WORKER_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
VM_WORKER_ALLOWED_REPOSITORIES=trained-assist/ai-agent-runner
VM_WORKER_ALLOWED_ENV=LLM_LADDER_TOKEN
VM_WORKER_ALLOWED_CALLBACK_ORIGINS=https://agent-api.example.com
VM_WORKER_CPU_RESERVATION_PCT=10
VM_WORKER_MEMORY_RESERVATION_PCT=10
OPENCODE_BIN=/usr/local/bin/opencode
STORAGE_BACKEND=gcs
GCS_BUCKET=REPLACE_WITH_RUN_ARTIFACT_BUCKET
AGENT_API_ENGINE_CONFIG_DIR=/etc/ai-agent-runner/engine-config
# Required only when runs carry trusted Control Plane ingressManifest pins.
# RUNNER_CONTROL_PLANE_URL=https://control-plane.example.com
# RUNNER_CONTROL_PLANE_PRINCIPAL=runner-vm-worker
# RUNNER_CONTROL_PLANE_PRINCIPAL_SECRET=REPLACE_WITH_CONTROL_PLANE_PRINCIPAL_SECRET
# Optional host-owned read credential for cloning private repositories; it is never
# passed into OpenCode and is removed from persisted RunSpec immediately after clone.
# RUNNER_GIT_TOKEN=
# GCP_PROJECT=trained-assist-prod
